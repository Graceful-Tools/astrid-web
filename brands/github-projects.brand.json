    "forbidLiterals": [
      "Astrid",
      "astrid.cc"
    ],
    "logo": "/images/whitelabel-logo.png",
    "icon": "/icons/whitelabel-512.png",
    "wordmark": "lanes",
    "slogan": "Move work forward.",
