{
  "name": "Lanes for GitHub Projects",
  "description": "The GitHub Projects partner brand (spec docs/specs/GITHUB_PROJECTS_WHITELABEL.md §11.1, AWTD-1103): a generic Graceful Tools brand, \"Lanes for GitHub Projects\" — the descriptive form GitHub's brand guidelines allow. Signs in with GitHub (through the brand's own GitHub App) and SSO; Project Mode on; Issues sync, Google Tasks and task cost off, since GitHub Projects is the backend. Artwork reuses the GitHub-styled whitelabel images until the brand has its own. The GitHub App slug is a placeholder until the App is registered, NEXT_PUBLIC_BRAND_ENABLE_GITHUB_PROJECTS turns on the Projects backend (P4c, AWTD-1151).",
  "env": {
    "NEXT_PUBLIC_BRAND_NAME": "Lanes",
    "NEXT_PUBLIC_BRAND_TITLE": "Lanes for GitHub Projects",
    "NEXT_PUBLIC_BRAND_TAGLINE": "Your GitHub Projects, on every device",
    "NEXT_PUBLIC_BRAND_DOMAIN": "projects.gracefultools.com",
    "NEXT_PUBLIC_BRAND_SUPPORT_EMAIL": "support@projects.gracefultools.com",
    "NEXT_PUBLIC_BRAND_INBOUND_TASK_EMAIL": "tasks@projects.gracefultools.com",
    "NEXT_PUBLIC_BRAND_ACCENT_COLOR": "#0969da",
    "NEXT_PUBLIC_BRAND_DEFAULT_THEME": "light",
    "NEXT_PUBLIC_BRAND_FONT_FAMILY": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
    "NEXT_PUBLIC_BRAND_AGENT_NAME": "Lanes Assistant",
    "BRAND_AGENT_EMAIL_DOMAIN": "projects.gracefultools.com",
    "NEXT_PUBLIC_BRAND_LOGO": "/images/whitelabel-logo.png",
    "NEXT_PUBLIC_BRAND_WORDMARK": "lanes",
    "NEXT_PUBLIC_BRAND_SLOGAN": "Move work forward.",
    "NEXT_PUBLIC_BRAND_APP_STORE_URL": "",
    "NEXT_PUBLIC_BRAND_ICON": "/icons/whitelabel-512.png",
    "NEXT_PUBLIC_BRAND_ICON_SMALL": "/icons/whitelabel-96.png",
    "NEXT_PUBLIC_BRAND_GITHUB_APP_SLUG": "lanes-for-github-projects",
    "BRAND_ENABLED_AGENTS": "claude",
    "NEXT_PUBLIC_BRAND_APP_URL_SCHEME": "astrid",
    "NEXT_PUBLIC_BRAND_AUTH_PROVIDERS": "github,sso",
    "NEXT_PUBLIC_BRAND_ENABLE_PROJECT_MODE": "true",
    "NEXT_PUBLIC_BRAND_ENABLE_GITHUB_PROJECTS": "true",
    "NEXT_PUBLIC_BRAND_ENABLE_SYNC_GITHUB_ISSUES": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_SYNC_GOOGLE_TASKS": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_TASK_COST": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_CODING_AGENT": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_OPENCLAW": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_CHATGPT_ACTIONS": "false",
    "NEXT_PUBLIC_BRAND_ENABLE_EMAIL_TO_TASK": "false",
    "NEXT_PUBLIC_BRAND_WWW_REDIRECT": "false"
  },
  "expect": {
    "appName": "Lanes",
    "productTitle": "Lanes for GitHub Projects",
    "domain": "projects.gracefultools.com",
    "agentEmailDomain": "projects.gracefultools.com",
    "supportEmail": "support@projects.gracefultools.com",
    "inboundTaskEmail": "tasks@projects.gracefultools.com",
    "accentColor": "#0969da",
    "enabledAgents": [
      "astrid",
      "claude"
    ],
    "capabilities": {
      "githubProjects": true,
      "authGithub": true,
      "authSso": true,
      "authGoogle": false,
      "authApple": false,
      "authPasskey": false,
      "syncGoogleTasks": false,
      "syncGithubIssues": false,
      "codingAgent": false,
      "projectMode": true,
      "taskCost": false,
      "integrationMcp": true,
      "integrationOpenClaw": false,
      "integrationChatGptActions": false,
      "emailToTask": false,
      "calendarFeed": true
