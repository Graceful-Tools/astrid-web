{
  "name": "@gracefultools/astrid-sdk",
  "version": "1.0.0",
  "description": "Astrid agent runner: the astrid-agent command (queue, claim, release) and a typed REST client for the agent endpoints",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "astrid-agent": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "astrid",
    "agent",
    "runner",
    "task-queue",
    "cli",
    "automation"
  ],
  "author": "Astrid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Graceful-Tools/astrid-web.git",
    "directory": "packages/astrid-sdk"
  },
  "homepage": "https://astrid.cc",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
