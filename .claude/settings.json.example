{
  "permissions": {
    "allow": [
      // === Astrid MCP board tools (AWTD-963 / e629448e) ===
      // A SCHEDULED run has no terminal to grant a permission prompt in, and
      // `--permission-mode acceptEdits` pre-approves file edits only — so
      // without these every mcp__astrid__* call is denied and the loop falls
      // back to the OAuth scripts. That fallback works for the queue but CANNOT
      // see `attention`, which arrives only on get_agent_queue. A loop that
      // cannot hear what is said to it is the failure AWTD-963 existed to fix.
      // Named individually rather than mcp__astrid__*: a wildcard would also
      // pre-approve whatever is added to that server later.
      "mcp__astrid__get_agent_queue",
      "mcp__astrid__get_lists",
      "mcp__astrid__get_tasks",
      "mcp__astrid__get_task",
      "mcp__astrid__get_task_comments",
      "mcp__astrid__get_list_messages",
      "mcp__astrid__add_comment",
      "mcp__astrid__update_task",
      "mcp__astrid__create_task",
      // === Development & Build Tools ===
      "Bash(npm run *)",
      "Bash(npm run dev)",                        // All npm scripts (dev, test, build, lint, etc.)
      "Bash(npx *)",                         // All npx commands (prisma, tsx, tsc, etc.)
      "Bash(pnpm *)",                        // pnpm package manager commands
      "Bash(node *)",                        // Node.js script execution
      "Bash(DATABASE_URL=\"postgresql://postgres:password@localhost:5432/astrid_dev\" npx tsx scripts/check-claude-agent-user.ts)",
      "Bash(DATABASE_URL=\"postgresql://postgres:password@localhost:5432/astrid_dev\" npx tsx scripts/test-claude-api.ts)",
      "Bash(npm run predeploy)",
      "Bash(npm run predeploy:quick)",
      "Bash(npx tsx scripts/get-astrid-tasks.ts)",
      "Read(//dev/**)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run monitor:vercel:*)",
      "Bash(npx tsx:*)",
      "Bash(npm install)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bask(npm install --ignore-scripts)", 
      "Bash(curl -X POST http://localhost:300*)",
      "Bash(npm run dev:*)",
      "Bash(echo \"LIST_IMAGE_GEN_API_KEY length: $#LIST_IMAGE_GEN_API_KEY\")",
      "Bash(echo \"First 10 chars: $LIST_IMAGE_GEN_API_KEY:0:10\")",
      "Bash(npx tsx scripts/get-astrid-tasks.ts)",
      "Bash(echo \"🔍 Checking for deployment issues...\" && npm run monitor:vercel)",

      // === Database Operations ===
      "Bash(DATABASE_URL=* npx prisma *)",   // Prisma with any database URL
      "Bash(DATABASE_URL=* npx tsx scripts/*)", // Script execution with database
      "Bash(DATABASE_URL=* node scripts/*)", // Node script execution with database

      // === Source Control & Development ===
      "Bash(git *)",                         // All git operations
      "Bash(curl *)",                        // HTTP requests and API testing

      // === File & Text Operations ===
      "Bash(grep *)",                        // Text search operations
      "Bash(find *)",                        // File system search
      "Bash(sed *)",                         // Text manipulation
      "Bash(ls *)",                          // Directory listing
      "Bash(cat *)",                         // File content viewing
      "Bash(head *)",                        // File head viewing
      "Bash(tail *)",                        // File tail viewing
      "Bash(wc *)",                          // Word/line counting
      "Bash(sort *)",                        // Sorting operations

      // === Process Management ===
      "Bash(lsof *)",                        // List open files/processes
      "Bash(pkill *)",                       // Process termination
      "Bash(kill *)",                        // Process termination
      "Bash(ps *)",                          // Process listing

      // === Environment & System ===
      "Bash(export *)",                      // Environment variable setting
      "Bash(echo *)",                        // Output commands
      "Bash(env *)",                         // Environment inspection
      "Bash(which *)",                       // Command location
      "Bash(pwd)",                           // Working directory
      "Bash(cd *)",                          // Directory navigation
      "Bash(mkdir *)",                       // Directory creation
      "Bash(rm *)",                          // File removal
      "Bash(mv *)",                          // File moving
      "Bash(cp *)",                          // File copying
      "Bash(chmod *)",                       // Permission changes

      // === Testing & Development Servers ===
      "Bash(psql *)",                        // PostgreSQL client
      "Bash(redis-cli *)",                   // Redis client
      "Bash(source *)",                      // Script sourcing

      // === Web Research & External APIs ===
      "WebSearch",                           // Web search capabilities
      "WebFetch(domain:github.com)",         // GitHub API access
      "WebFetch(domain:api.github.com)",     // GitHub API access
      "WebFetch(domain:raw.githubusercontent.com)", // GitHub raw content
      "WebFetch(domain:docs.claude.com)",    // Claude documentation

      // === Astrid-Specific Development ===
      "Bash(npx tsx scripts/get-astrid-tasks.ts)", // Pull tasks from astrid.cc
      "Bash(npm run docs:review)",          // Documentation review helper

      // === Tree Command (if available) ===
      "Bash(tree *)"                        // Directory tree visualization
    ],
    "deny": [
      // Explicitly deny potentially destructive operations
      "Bash(rm -rf /)",                      // Prevent system destruction
      "Bash(sudo *)",                        // Prevent sudo operations
      "Bash(su *)",                          // Prevent user switching
      "Bash(chmod 777 *)",                   // Prevent overly permissive permissions
      "Bash(dd *)"                           // Prevent disk operations
    ],
    "ask": [
      // Operations that require user confirmation
      "Bash(npm publish *)",                 // Package publishing
      // Pushing `main` is NOT a production deploy and must never be gated here:
      // production-deployment.yml is workflow_dispatch-only (#204), so a push
      // ships nothing, and CLAUDE.md rule 3 requires pushing without asking.
      // An `ask` entry beats the `Bash(git *)` allow and silently strands every
      // scheduled run's work on local main (AWTD-978).
      "Bash(npx prisma migrate reset *)",    // Destructive database operations
      "Bash(npx prisma db push --force-reset *)" // Destructive database operations
    ]
  },
  // Auto mode decides through a classifier, which plain allow rules do not override. These rules
  // tell it what Jon approved as reversible housekeeping (2026-11-28, "Fewer interventions"
  // analysis). "$defaults" keeps every built-in rule: secrets, branch protection, force-push and
  // deletes still go through the classifier.
  "autoMode": {
    "allow": [
      "$defaults",
      "Merging, closing or reopening pull requests in Graceful-Tools repositories with gh pr merge, gh pr close or gh pr reopen, including --delete-branch and a closing comment. Jon approved this as reversible housekeeping on 2026-11-28: a closed PR can be reopened, and merging to main deploys nothing because production deploys are a separate manual workflow.",
      "Cancelling or re-running GitHub Actions workflow runs in Graceful-Tools repositories with gh run cancel or gh run rerun, for example a duplicate deploy run or a flaky job. Jon approved this on 2026-11-28.",
      "Posting a Dependabot command (such as @dependabot rebase or @dependabot recreate) as a comment on a Dependabot pull request in a Graceful-Tools repository. Jon approved this on 2026-11-28."
    ]
  }
}
