# Self-hosted deployment settings (AWTD-1286). Copy to .env beside this file;
# docker compose reads it both for the stack and for the app.
# The full registry of variables: `npm run check:env`, or lib/env.ts.
# Guide: docs/deployment/SELF_HOSTING.md.

# ── Build ────────────────────────────────────────────────────────────────────
# A profile in brands/ (or a path in the build context). Empty builds Astrid's
# defaults. Every NEXT_PUBLIC_* value (name, colours, capability switches,
# sign-in providers) is compiled in at build, so it belongs in the profile:
# set here at runtime it is ignored, and the app logs a warning saying so.
BRAND=
GIT_COMMIT_SHA=

# ── Required ─────────────────────────────────────────────────────────────────
# Where users reach the app, scheme included. Sign-in callbacks and every
# absolute link derive from it. Production needs HTTPS (secure cookies,
# passkeys): put a TLS proxy in front, or use `--profile tls` below.
NEXTAUTH_URL=https://tasks.example.com
# openssl rand -base64 48
NEXTAUTH_SECRET=
# openssl rand -hex 32   — losing it makes stored credentials unrecoverable; back it up
ENCRYPTION_KEY=
# openssl rand -hex 32   — the cron service sends it; every cron route fails closed without it
CRON_SECRET=
POSTGRES_PASSWORD=

# ── TLS (docker compose --profile tls) ───────────────────────────────────────
# Caddy obtains and renews a certificate for this name. DNS must point here and
# ports 80/443 must be reachable. Behind it, one proxy hop:
SITE_DOMAIN=tasks.example.com
TRUSTED_PROXY_DEPTH=1

# ── Storage ──────────────────────────────────────────────────────────────────
# local: the `uploads` volume. s3: any S3-compatible store (AWS, MinIO, R2, Ceph).
# azure-blob: Azure Blob Storage (`--profile azure` runs Azurite to try it).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://minio.internal:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# azure-blob: an Azure Blob container (create it first). A connection string, or
# the account name with Managed Identity (Storage Blob Data Contributor + Delegator).
# AZURE_STORAGE_CONTAINER=attachments
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# With --profile azure (Azurite's published development account, not a secret).
# Downloads redirect to the BlobEndpoint, so with Azurite only uploads and the
# app-served object URLs work from a browser; real Azure has a public endpoint.
# AZURE_STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;'

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Passkeys work with nothing else configured. WHICH providers exist is a
# NEXT_PUBLIC_* switch, so it goes in the brand profile, not here (see
# docs/WHITELABELING.md §3, "Sign-in providers"); their credentials go here. A
# listed provider without its credentials stops the boot.
# AUTH_SSO_ISSUER=https://login.example.com
# AUTH_SSO_CLIENT_ID=
# AUTH_SSO_CLIENT_SECRET=
# AUTH_SSO_DOMAINS=example.com
# INITIAL_ADMIN_EMAIL=you@example.com

# ── Optional services ────────────────────────────────────────────────────────
# Email. Without a transport nothing is sent and sends are logged instead.
# Any SMTP relay (Azure Communication Services, SendGrid, Exchange Online):
# EMAIL_TRANSPORT=smtp
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# To try it with the bundled sink (docker compose --profile mail; inbox at
# http://localhost:8025):
# SMTP_URL=smtp://mailpit:1025
# Or Resend (the default when EMAIL_TRANSPORT is unset):
# RESEND_API_KEY=
# FROM_EMAIL=noreply@example.com
# Web push: npx web-push generate-vapid-keys. The browser half is compiled in,
# so NEXT_PUBLIC_VAPID_PUBLIC_KEY is a build argument: set it, then rebuild.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com
