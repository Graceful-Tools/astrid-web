generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                           String                 @id @default(cuid())
  name                         String?
  email                        String                 @unique
  emailVerified                DateTime?
  image                        String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  isActive                     Boolean                @default(true)
  pendingEmail                 String?
  emailVerificationToken       String?                @unique
  emailTokenExpiresAt          DateTime?
  aiAssistantSettings          String?
  defaultDueTime               String?                @default("17:00")
  subtaskDisplay               String?                @default("indented") // "indented" (in lists) | "under_parent" (detail only)
  mcpEnabled                   Boolean                @default(true)
  mcpSettings                  String?
  aiAgentConfig                String?
  aiAgentType                  String?
  isAIAgent                    Boolean                @default(false)
  webhookUrl                   String?
  defaultNewListMcpAccessLevel String                 @default("WRITE")
  defaultNewListMcpEnabled     Boolean                @default(true)
  defaultTaskDueOffset         String?                @default("1_week")
  emailToTaskEnabled           Boolean                @default(true)
  emailToTaskListId            String?
  smartTaskCreationEnabled     Boolean                @default(true)
  invitedBy                    String?
  isPlaceholder                Boolean                @default(false)
  statsCompletedTasks          Int                    @default(0)
  statsInspiredTasks           Int                    @default(0)
  statsSupportedTasks          Int                    @default(0)
  statsLastCalculated          DateTime?
  myTasksPreferences           String?
  accounts                     Account[]
  authenticators               Authenticator[]
  comments                     Comment[]
  githubIntegrations           GitHubIntegration[]
  receivedInvitations          Invitation[]           @relation("InvitationReceiver")
  sentInvitations              Invitation[]           @relation("InvitationSender")
  createdInvites               ListInvite[]           @relation("ListInviteCreator")
  listMemberships              ListMember[]           @relation("ListMembership")
  mcpTokens                    MCPToken[]
  oauthClients                 OAuthClient[]          @relation("OAuthClients")
  oauthTokens                  OAuthToken[]           @relation("OAuthTokens")
  ownedProjects                Project[]              @relation("ProjectOwner")
  projectMemberships           ProjectMember[]        @relation("ProjectMembership")
  pushSubscriptions            PushSubscription[]
  reminderQueue                ReminderQueue[]
  reminderSettings             ReminderSettings?
  webhookConfig                UserWebhookConfig?
  secureFiles                  SecureFile[]
  sessions                     Session[]
  assignedTasks                Task[]                 @relation("TaskAssignee")
  createdTasks                 Task[]                 @relation("TaskCreator")
  ownedLists                   TaskList[]             @relation("ListOwner")
  analyticsEvents              AnalyticsEvent[]       @relation("AnalyticsEvents")
  adminUser                    AdminUser?             @relation("AdminUsers")
  chatMessages                 ChatMessage[]
  addressBookContacts          AddressBookContact[]   @relation("AddressBookContacts")
  userListFavorites            UserListFavorite[]     @relation("UserFavorites")
  integrations                 Integration[]          @relation("UserIntegrations")
  copilotCredential            CopilotCredential?     @relation("UserCopilotCredential")
  featureAccessRequests        FeatureAccessRequest[] @relation("UserFeatureAccessRequests")
  notifications                Notification[]         @relation("UserNotifications")

  @@index([email])
  @@index([emailVerified])
  @@index([createdAt])
  @@index([isActive])
  @@index([emailVerificationToken])
  @@index([isAIAgent])
  @@index([aiAgentType])
  @@index([isAIAgent, aiAgentType])
  @@index([isPlaceholder])
  @@index([invitedBy])
  @@index([emailToTaskEnabled])
  @@index([statsLastCalculated])
}

model AddressBookContact {
  id          String   @id @default(cuid())
  userId      String
  email       String // Normalized to lowercase
  name        String?
  phoneNumber String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("AddressBookContacts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([email])
  @@index([userId])
}

model AIAgent {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  service       String
  agentType     String   @map("agent_type")
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  config        Json?
  webhookUrl    String?  @map("webhook_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  assignedTasks Task[]

  @@unique([service, agentType])
  @@index([isActive])
  @@index([service])
  @@map("ai_agents")
}

model TaskList {
  id                      String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                    String
  description             String?
  color                   String             @default("#3b82f6")
  imageUrl                String?
  projectId               String?
  listType                String             @default("regular")
  statusRole              String?
  statusOrder             Int?
  statusDescription       String?
  statusCompleted         Boolean            @default(false)
  privacy                 TaskListPrivacy    @default(PRIVATE)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  ownerId                 String
  defaultAssigneeId       String?
  defaultPriority         Int?               @default(0)
  defaultRepeating        String?            @default("never")
  defaultIsPrivate        Boolean?           @default(true)
  defaultDueDate          String?            @default("none")
  aiAstridEnabled         Boolean            @default(false)
  copyCount               Int                @default(0)
  defaultDueTime          String?
  favoriteOrder           Int?
  filterAssignedBy        String?
  filterAssignee          String?
  filterCompletion        String?
  /// Per-list "Recently completed" window — null = legacy 24h default.
  /// Shape: see lib/recently-completed-window.ts → RecentlyCompletedWindow.
  recentlyCompletedWindow Json?
  /// Show subtasks inline in this list. Default/absent = SHOW, so lists that
  /// predate the column keep rendering subtasks. Combined with the user-level
  /// User.subtaskDisplay by lib/list-subtask-visibility.ts: a list may opt
  /// out, but cannot opt back in over a user's detail-only preference.
  showSubtasks            Boolean            @default(true)
  filterDueDate           String?
  filterInLists           String?
  filterPriority          String?
  filterRepeating         String?
  isFavorite              Boolean            @default(false)
  isVirtual               Boolean            @default(false)
  sortBy                  String?
  virtualListType         String?
  mcpAccessLevel          MCPAccessLevel     @default(WRITE)
  mcpEnabled              Boolean            @default(false)
  aiAgentsEnabled         Json?              @default("[]")
  fallbackAiProvider      String?
  githubRepositoryId      String?
  preferredAiProvider     String?
  aiAgentConfiguredBy     String?
  manualSortOrder         Json?
  publicListType          String?
  listInvites             ListInvite[]
  listMembers             ListMember[]
  mcpTokens               MCPToken[]
  secureFiles             SecureFile[]
  chatChannel             ChatChannel?
  userListFavorites       UserListFavorite[] @relation("ListFavorites")
  owner                   User               @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project                 Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks                   Task[]             @relation("TaskToTaskList")
  externalLinks           ExternalListLink[] @relation("ListExternalLinks")

  @@index([ownerId])
  @@index([projectId])
  @@index([projectId, listType])
  @@index([projectId, statusOrder])
  @@index([privacy])
  @@index([createdAt])
  @@index([defaultAssigneeId])
  @@index([isFavorite, favoriteOrder])
  @@index([ownerId, isFavorite])
  @@index([virtualListType])
  @@index([mcpEnabled])
}

model Project {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  description  String?
  color        String          @default("#3b82f6")
  imageUrl     String?
  ownerId      String
  /// Short prefix for this project's task identifiers, e.g. "AST" in AST-142
  /// (task 12f54df4). Unique per owner, not globally: two people may both have
  /// an "AST" and forcing global uniqueness would hand out ugly keys for no
  /// benefit. Null for projects created before identifiers existed.
  key          String?
  /// Per-project custom board states — a Project-Mode-only feature (AWTD-562).
  /// Shape: [{ role, name, description?, order }]. The defaults
  /// (ready/doing/waiting) are code constants shared by every board and are
  /// NOT stored here. A custom state may not shadow a default role.
  customStates Json?
  /// Next identifier to hand out. Allocated with an atomic UPDATE ... RETURNING
  /// inside the task-create transaction — never SELECT max()+1, because
  /// concurrent creation from web, iOS, MCP and agents is the normal case here,
  /// not an edge case. Never decremented: identifiers are not reused, including
  /// after delete, or a branch named ast-142-* would come to mean another task.
  nextSequence Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  lists        TaskList[]

  @@unique([ownerId, key])
  @@index([ownerId])
  @@index([createdAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([projectId, role])
}

model Task {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  title              String
  description        String             @default("")
  priority           Int                @default(0)
  repeating          String             @default("never")
  repeatingData      Json?
  isPrivate          Boolean            @default(true)
  completed          Boolean            @default(false)
  /// When the task was completed. Backdatable by sync (a task completed in
  /// Google/GitHub keeps its real completion time). Null for legacy rows —
  /// consumers fall back to updatedAt.
  completedAt        DateTime?
  /// Where the completion happened: astrid | google | github | apple.
  completedSource    String?
  /// Why the task was closed, when it was not simply done (task 11042ae3):
  /// canceled | duplicate | not_planned. Null means completed normally, or
  /// still open — so every existing query keeps working untouched.
  ///
  /// Closing as canceled still sets `completed = true`: the task leaves active
  /// views, lands in the virtual Done column and respects the recently-completed
  /// window exactly as before. Only the rendering and the reporting differ.
  closedReason       String?
  /// Human-readable identifier, e.g. "AST-142" (task 12f54df4). Denormalized
  /// from the project key + sequence so display and lookup need no join.
  /// Null for tasks that were never in a project — a solo user never sees one.
  /// Permanent once minted: a task moved out of a project keeps it.
  identifier         String?
  /// The numeric half of `identifier`, kept for ordering and for re-deriving
  /// the string if a project is ever re-keyed.
  sequence           Int?
  /// Board status as a STATE on the task (task AWTD-562): ready | doing |
  /// waiting | <a project's custom role>. Null means Inbox; Done is derived
  /// from `completed`, so neither is ever stored.
  ///
  /// Replaces membership in a `listType: 'status'` TaskList. That model could
  /// not be both per-user (or pickers filled with duplicate lists) and shared
  /// (or two members of a board resolved different columns). As a field on the
  /// shared task both hold, and "at most one status" is true by construction
  /// rather than enforced by a normalizer.
  statusRole         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assigneeId         String?
  creatorId          String?
  originalTaskId     String?
  sourceListId       String?
  dueDateTime        DateTime?
  isAllDay           Boolean            @default(false)
  reminderSent       Boolean            @default(false)
  reminderTime       DateTime?
  reminderType       String?
  aiAgentId          String?
  clientRequestId    String?            @unique
  occurrenceCount    Int                @default(0)
  repeatFrom         RepeatFromMode     @default(COMPLETION_DATE)
  timerDuration      Int?
  lastTimerValue     String?
  // Subtasks: self-relation. SetNull on parent delete — subtasks promote to
  // top-level rather than being silently destroyed. (originalTaskId/sourceListId
  // are copy-lineage; do NOT overload them for hierarchy.)
  parentTaskId       String?
  parentTask         Task?              @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks           Task[]             @relation("TaskSubtasks")
  externalLinks      ExternalTaskLink[] @relation("TaskExternalLinks")
  attachments        Attachment[]
  /// Expected cost in MICROCENTS at the time work was authorised. Null = never
  /// estimated, which is the overwhelmingly common case and draws no UI.
  /// Snapshot semantics: records what we believed BEFORE the work and is never
  /// recomputed, otherwise variance measures nothing. (Task 315949e1.)
  costEstimateMicrocents Int?
  /// How the estimate was produced: human | cohort | model.
  costEstimateSource String?

  codingWorkflow CodingTaskWorkflow?
  comments       Comment[]
  costEvents     TaskCostEvent[]
  events         TaskEvent[]
  notifications  Notification[]
  reminderQueue  ReminderQueue[]
  secureFiles    SecureFile[]
  aiAgent        AIAgent?            @relation(fields: [aiAgentId], references: [id])
  assignee       User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator        User?               @relation("TaskCreator", fields: [creatorId], references: [id])
  lists          TaskList[]          @relation("TaskToTaskList")

  @@unique([identifier])
  @@index([assigneeId])
  @@index([aiAgentId])
  @@index([creatorId])
  @@index([completed])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([completed, priority, createdAt])
  @@index([dueDateTime])
  @@index([reminderTime])
  @@index([priority])
  @@index([assigneeId, completed])
  @@index([createdAt, completed])
  @@index([dueDateTime, completed])
  @@index([reminderTime, reminderSent])
  @@index([repeating])
  @@index([creatorId, createdAt])
  @@index([parentTaskId])
  @@index([closedReason])
  @@index([statusRole])
}

/// Append-only task activity history (task 51a4b8ff).
///
/// Never updated, never deleted except by task cascade. Matters more here than
/// in a conventional tracker because AI agents mutate tasks autonomously —
/// "who moved this to Doing, and when" was previously unanswerable, which is
/// both a trust problem and what makes agent misbehaviour undebuggable.
///
/// Distinct from the prose system comments in lib/task-state-change-tracker.ts:
/// those are what a human reads in the thread, these are structured rows that
/// can be queried, counted and fanned out into notifications.
model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  /// Null for system-originated changes.
  actorId   String?
  /// user | agent | sync | system
  actorType String
  /// One of TASK_EVENT_KINDS in lib/task-events.ts.
  kind      String
  from      Json?
  to        Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@index([kind, createdAt])
}

/// In-app notification (task ab0572cb).
///
/// Derived from TaskEvent fan-out, never written independently — two write
/// paths for "something happened" would guarantee drift, and the event trail
/// already knows who did what.
///
/// Astrid's notifications were due-date only before this: nothing fired on
/// assignment, @-mention, reply or completion.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// assigned | mentioned | replied | commented | status_changed | completed
  kind      String
  taskId    String?
  commentId String?
  /// Who caused it. Never equal to userId — nobody is told what they just did.
  actorId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// The unread-count query.
  @@index([userId, readAt, createdAt])
  @@index([taskId])
}

model Comment {
  id              String       @id @default(cuid())
  content         String
  type            CommentType  @default(TEXT)
  /// Typed discriminator for system-authored comments (authorId = null),
  /// task 59e2dcff. Clients previously identified a completion comment by
  /// pattern-matching the English string "marked this as complete" — so
  /// localising or rewording that sentence would silently break the
  /// completion-streak fold on web, iOS and Mac simultaneously.
  ///
  /// Values mirror the StateChange fields in lib/task-state-change-tracker.ts:
  /// COMPLETED | REOPENED. Null for user-written comments and for system
  /// comments predating this field, so consumers must tolerate null.
  systemEventType String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  authorId        String?
  taskId          String
  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?
  attachmentSize  Int?
  parentCommentId String?
  clientRequestId String?      @unique
  author          User?        @relation(fields: [authorId], references: [id])
  parentComment   Comment?     @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]    @relation("CommentReplies")
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  secureFiles     SecureFile[]

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
  @@index([taskId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([taskId, systemEventType])
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
}

model SecureFile {
  id              String       @id @default(cuid())
  blobUrl         String       @unique
  originalName    String
  mimeType        String
  fileSize        Int
  uploadedBy      String
  taskId          String?
  listId          String?
  commentId       String?
  chatMessageId   String?
  clientRequestId String?
  /// What the file was uploaded FOR, recorded at upload time (task ded31696):
  /// "message" (a comment or chat composer) | "task" (the task form) | null on
  /// every row written before this existed. A composer uploads with a taskId
  /// context — that is how the write is authorized — and commentId is only
  /// stamped on when the message is sent, so a file staged in a composer is
  /// otherwise indistinguishable from one attached to the task itself.
  attachTarget    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  chatMessage     ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  comment         Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  list            TaskList?    @relation(fields: [listId], references: [id], onDelete: Cascade)
  task            Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader        User         @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  // Idempotency key is unique PER UPLOADER (not globally) so a client can't
  // reuse another user's clientRequestId to retrieve their file.
  @@unique([uploadedBy, clientRequestId])
  @@index([uploadedBy])
  @@index([taskId])
  @@index([listId])
  @@index([commentId])
  @@index([chatMessageId])
  @@index([createdAt])
  @@index([blobUrl])
}

model Invitation {
  id         String           @id @default(cuid())
  email      String
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  type       InvitationType   @default(TASK_ASSIGNMENT)
  role       String?
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  senderId   String?
  receiverId String?
  taskId     String?
  listId     String?
  projectId  String?
  message    String?
  receiver   User?            @relation("InvitationReceiver", fields: [receiverId], references: [id])
  sender     User?            @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([token])
  @@index([senderId])
  @@index([receiverId])
  @@index([type])
  @@index([expiresAt])
  @@index([email, status])
  @@index([senderId, status])
  @@index([projectId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  id                   String   @id @default(cuid())
  credentialID         String   @unique
  credentialPublicKey  String
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  userId               String
  name                 String?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebAuthnChallenge {
  id        String   @id
  challenge String
  userId    String?
  email     String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ListMember {
  id        String   @id @default(cuid())
  listId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User     @relation("ListMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([listId])
  @@index([userId])
  @@index([listId, role])
}

model UserListFavorite {
  id            String   @id @default(cuid())
  userId        String
  listId        String
  favoriteOrder Int
  createdAt     DateTime @default(now())

  user User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  list TaskList @relation("ListFavorites", fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@index([userId, favoriteOrder])
  @@index([listId])
}

model ListInvite {
  id        String   @id @default(cuid())
  listId    String
  email     String
  token     String   @unique
  role      String   @default("member")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("ListInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  list      TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, email])
  @@index([listId])
  @@index([email])
  @@index([token])
  @@index([createdBy])
}

model ReminderSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  enablePushReminders  Boolean  @default(true)
  enableEmailReminders Boolean  @default(true)
  defaultReminderTime  Int      @default(60)
  enableDailyDigest    Boolean  @default(true)
  dailyDigestTime      String   @default("09:00")
  dailyDigestTimezone  String   @default("UTC")
  quietHoursStart      String?
  quietHoursEnd        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  calendarSyncType     String   @default("all")
  enableCalendarSync   Boolean  @default(false)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserWebhookConfig {
  id            String    @id @default(cuid())
  userId        String    @unique
  webhookUrl    String // Encrypted - URL for Code Remote server
  webhookSecret String // Encrypted - HMAC secret for signing requests
  enabled       Boolean   @default(true)
  events        String[]  @default(["task.assigned", "comment.created"])
  agents        String[]  @default([]) // Which agents this webhook handles (opt-in, empty = none)
  lastFiredAt   DateTime?
  failureCount  Int       @default(0)
  maxRetries    Int       @default(3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("user_webhook_configs")
}

// Webhook delivery audit log for reliability tracking
model WebhookDeliveryLog {
  id             String   @id @default(cuid())
  userId         String
  taskId         String
  event          String // task.assigned, comment.created, etc.
  webhookUrl     String // Target URL (not encrypted for debugging)
  status         String // pending, success, failed
  attempts       Int      @default(0)
  responseCode   Int? // HTTP status code if received
  responseTimeMs Int? // Response time in milliseconds
  errorMessage   String? // Error details if failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
