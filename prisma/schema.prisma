/// Server-owned rollout configuration. Unknown or missing flags always
/// evaluate to disabled; clients receive only their effective values.
model FeatureFlag {
  id                String              @id @default(cuid())
  key               String              @unique
  displayName       String
  description       String?
  enabled           Boolean             @default(false)
  rolloutMode       String              @default("OFF")
  rolloutPercentage Int                 @default(0)
  version           Int                 @default(1)
  updatedByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  targets           FeatureFlagTarget[]
  audits            FeatureFlagAudit[]

  @@index([enabled])
}

model FeatureFlagTarget {
  id              String      @id @default(cuid())
  featureFlagId   String
  userId          String
  treatment       String
  createdByUserId String?
  createdAt       DateTime    @default(now())
  featureFlag     FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, userId])
  @@index([userId])
}

/// A user asking for access to a gated feature (task dd7172d8).
///
/// The point of this table is **demand measurement**: how many distinct people
/// want Project Mode. Hence `@@unique([userId, featureKey])` — one person
/// asking twice is one data point, not two, and re-requesting updates the note
/// instead of inflating the count.
///
/// Deliberately NOT a payments or entitlement record. Granting access happens
/// through the existing FeatureFlagTarget INCLUDE mechanism; this row only
/// remembers that someone asked and what for.
model FeatureAccessRequest {
  id            String    @id @default(cuid())
  userId        String
  /// Matches a FEATURE_KEYS value in lib/feature-flags.ts.
  featureKey    String
  /// Free-text "what would you use this for" — the qualitative half of the signal.
  useCase       String?
  /// PENDING | GRANTED | DECLINED
  status        String    @default("PENDING")
  /// Set when an admin grants or declines, for queue triage.
  reviewedAt    DateTime?
  reviewedBy    String?
  /// True for users auto-granted at migration time because they already had a
  /// board. Counted separately so they don't pollute the demand signal.
  grandfathered Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation("UserFeatureAccessRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([featureKey, status, createdAt])
  @@index([userId])
}

model FeatureFlagAudit {
  id              String      @id @default(cuid())
  featureFlagId   String
  changedByUserId String
  before          Json
  after           Json
  createdAt       DateTime    @default(now())
  featureFlag     FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@index([featureFlagId, createdAt])
  @@index([changedByUserId])
}

// ── Multi-provider external sync (spec: plan zippy-exploring-gray) ──────────
// Client-side sync EXECUTION; the server stores per-user credentials + links
// so the collaboration superset works (each member mirrors shared task content
// to their own provider). Apple Reminders links stay device-local by design.

enum ExternalSyncProvider {
  APPLE_REMINDERS
  GOOGLE_TASKS
  GITHUB_ISSUES
}

enum ExternalSyncDirection {
  EXPORT
  IMPORT
  BIDIRECTIONAL
}

/// Per-user GitHub Copilot OAuth credential for the copilot@astrid.cc agent.
/// Deliberately separate from Integration (external content sync, with
/// list/task links) and GitHubIntegration (coding-agent GitHub App): this is
/// only an auth token for calling the user's own Copilot entitlement.
/// Tokens are encrypted at the app layer (lib/field-encryption). refreshToken
/// + expiresAt are populated only for GitHub App expiring tokens; a plain
/// OAuth App token leaves them null and copilotTokenFor just returns it.
model CopilotCredential {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String // encrypted
  refreshToken String? // encrypted
  expiresAt    DateTime?
  scopes       String[]
  githubLogin  String? // identity mapping
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("UserCopilotCredential", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Durable per-user OAuth credential store for sync providers (tokens encrypted
/// at the app layer). Distinct from GitHubIntegration (AI coding-agent feature).
model Integration {
  id                String               @id @default(cuid())
  userId            String
  provider          ExternalSyncProvider
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  scopes            String[]
  externalAccountId String? // Google email / GitHub login — identity mapping
  metadata          Json?
  revokedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation("UserIntegrations", fields: [userId], references: [id], onDelete: Cascade)
  listLinks         ExternalListLink[]
  taskLinks         ExternalTaskLink[]

  @@unique([userId, provider])
  @@index([userId])
}

/// One Astrid list ↔ one remote container (GitHub owner/repo, Google tasklist)
/// for ONE user. Different members can bind the same list to different providers.
model ExternalListLink {
  id                  String                @id @default(cuid())
  integrationId       String
  userId              String
  astridListId        String
  provider            ExternalSyncProvider
  remoteContainerId   String // "owner/repo" / Google tasklist id
  remoteContainerName String?
  direction           ExternalSyncDirection @default(BIDIRECTIONAL)
  includeCompleted    Boolean               @default(true)
  cursor              String? // GitHub "issues since" watermark / Google syncToken
  lastReconciledAt    DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  integration         Integration           @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  list                TaskList              @relation("ListExternalLinks", fields: [astridListId], references: [id], onDelete: Cascade)

  @@unique([userId, astridListId, provider])
  @@index([astridListId])
  @@index([integrationId])
}

/// The superset key: per-(user, task, provider) external identity with dual
/// watermarks for echo suppression and a metadata blob for provider extras
/// (labels, milestone, issue number, state_reason, parent...).
model ExternalTaskLink {
  id                String               @id @default(cuid())
  integrationId     String
  userId            String
  astridTaskId      String
  provider          ExternalSyncProvider
  remoteId          String // GitHub issue number ("owner/repo#123") / Google task id
  remoteContainerId String
  astridUpdatedAt   DateTime?
  remoteUpdatedAt   DateTime?
  lastSyncedAt      DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  integration       Integration          @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  task              Task                 @relation("TaskExternalLinks", fields: [astridTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, astridTaskId, provider])
  @@unique([provider, remoteId, userId])
  @@index([astridTaskId])
  @@index([remoteContainerId])
  @@index([userId, provider, remoteContainerId])
}

/// Tombstones for delta sync. Tasks and lists are hard-deleted, so an
/// incremental sync (`updatedSince`) had no way to tell a client that something
/// disappeared — deleted rows simply lingered on screen until a full refetch.
///
/// `audienceIds` captures who could see the entity at the moment it was
/// deleted, so each client is told only about deletions it cares about. Rows
/// are pruned well past the sync cursor's 24h validity window.
model DeletionLog {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  deletedAt   DateTime @default(now())
  audienceIds String[]

  @@index([entity, deletedAt])
  @@index([deletedAt])
}

/// Append-only ledger of what a task ACTUALLY cost. (Task 315949e1.)
///
/// A task's actual cost is sum(costCents) over its events. Deliberately NOT
/// denormalised onto Task in v1 — add a cached column only after a measurement
/// shows the sum is slow, and say so in the commit.
///
/// Why the money is stored and not derived: token counts are facts, money is a
/// fact about a price list that changes. Multiplying tokens by today's prices at
/// read time would silently re-price every historical task whenever a provider
/// changed rates, and last quarter's variance analysis would quietly become
/// fiction. So costCents is computed once at write time and never recomputed. A
/// wrong price is corrected with a compensating event, not an UPDATE — the
/// ledger is the audit trail.
model TaskCostEvent {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  taskId       String
  /// Which agent incurred it, when we know.
  aiAgentId    String?
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  /// Tokens served from the provider's prompt cache, kept SEPARATE from
  /// inputTokens because they are billed at roughly a tenth of the rate
  /// (Jon, task 315949e1: "Store them separately"). Collapsing them into one
  /// input number would make the recorded cost materially wrong for exactly
  /// the workloads worth measuring — long agent runs with big cached prompts,
  /// which is most of what this app does.
  cacheReadTokens  Int @default(0)
  /// Tokens written INTO the cache. Anthropic bills these at a premium over
  /// ordinary input, so they are neither input nor cache-read; a third column
  /// is the only shape that prices all three correctly.
  cacheWriteTokens Int @default(0)
  /// Cost in MICROCENTS, COMPUTED AND FROZEN AT WRITE TIME.
  ///
  /// Not cents: model prices are quoted per million tokens and a single call
  /// routinely costs a fraction of a cent, so cents would round almost every
  /// row to zero. Not a float: 0.1 + 0.2 drift accumulates across aggregation,
  /// and totals that do not add up destroy trust in the whole feature. An
  /// integer count of microcents (1 dollar = 100,000,000) sums exactly over
  /// millions of rows and costs one formatting helper.
  costMicrocents Int
  /// Idempotency key from the reporter, so a retried report is not
  /// double-counted. Unique per task, not globally: two different tasks may
  /// legitimately be reported under the same run id by different agents.
  externalId   String?
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, externalId])
  @@index([taskId])
  @@index([aiAgentId, createdAt])
}
