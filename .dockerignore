# The self-hosted image (Dockerfile, AWTD-1286). Secrets and machine state stay out:
# an image is a file anyone with registry access can unpack.
.env*
!.env.example
.vercel
.claude
# Typechecked by `next build` (scripts/check-board-permissions.ts imports it).
!.claude/validate-settings.ts
.git
.github
.husky
.next
.tmp
node_modules
coverage
dist
logs
playwright-report
test-results
data
*.tsbuildinfo
.eslintcache
.DS_Store
# An operator's mounted brand (deploy/self-host/docker-compose.yml): mounted at start,
# never built in (AWTD-1606).
deploy/self-host/brand
deploy/self-host/brand.override.yml
