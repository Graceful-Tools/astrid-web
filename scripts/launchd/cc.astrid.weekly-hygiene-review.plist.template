<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly hygiene review.

  A TEMPLATE, not an installable plist. Create the worktree it runs from, then install:

    git worktree add ../astrid-web-hygiene main
    ./scripts/launchd/install.sh cc.astrid.weekly-hygiene-review

  The job runs from a sibling worktree nobody works in, so the schedule never depends
  on which branch a shared checkout happens to be sitting on — hence __REPO_PARENT__
  rather than __REPO_ROOT__. Re-run the installer after moving the checkout; no path
  is committed, so there is nothing to hand-edit and nothing to rot.

  Keep both the checkout and that worktree out of TCC-protected directories
  (~/Documents, ~/Desktop, ~/Downloads) — from there a launchd agent hangs pending
  consent instead of failing. See docs/WEEKLY_HYGIENE_REVIEW.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cc.astrid.weekly-hygiene-review</string>

    <!--
      node, not zsh: a zsh launched straight by launchd has no TCC access to protected
      locations, and git dies before the run starts. The shim also self-locates the repo,
      which is what lets this template name only __REPO_ROOT__. Keep it. See the shim.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__REPO_PARENT__/astrid-web-hygiene/scripts/run-weekly-hygiene-review.mjs</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HYGIENE_SELF_UPDATE</key>
        <string>1</string>
    </dict>

    <!-- Fridays at 15:50 local time. If the Mac is asleep, launchd runs it next time it wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/astrid-weekly-hygiene-review.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/astrid-weekly-hygiene-review.log</string>
</dict>
</plist>
