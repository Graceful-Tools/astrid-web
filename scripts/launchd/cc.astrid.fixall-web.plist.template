<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scheduled /fixall for the Astrid Web board (AWTD-971).

  A TEMPLATE, not an installable plist. Install it with:

    ./scripts/launchd/install.sh cc.astrid.fixall-web

  which fills in this checkout's absolute paths, then bootstraps the job. Re-run it after moving the checkout; no path is
  committed, so there is nothing to hand-edit and nothing to rot.

  KEEP THE CHECKOUT OUT OF TCC-PROTECTED DIRECTORIES (~/Documents, ~/Desktop,
  ~/Downloads). From one of those, a launchd agent reading the repo BLOCKS pending
  consent rather than failing: the job sits in `state = running` with an empty log
  and launchd swallows every later tick. Verified 2026-09-19 from ~/Documents. The
  escape hatch is Full Disk Access for `readlink -f /opt/homebrew/bin/node`, but
  that is a broad grant to a general-purpose interpreter — moving the checkout is
  the cheaper fix.

  Confirm it works before trusting it:

    launchctl kickstart gui/$(id -u)/cc.astrid.fixall-web
    tail ~/Library/Logs/astrid-fixall-web.log      # must show a RESULT: line

  Stop it again with:

    launchctl bootout gui/$(id -u)/cc.astrid.fixall-web

  See .claude/commands/fixall.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cc.astrid.fixall-web</string>

    <!--
      node, not zsh: a zsh launched straight by launchd has no TCC access to protected
      locations, and git dies before the run starts. The shim also self-locates the repo,
      which is what lets this template carry a single repo path. Keep it. See the shim.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__REPO_ROOT__/scripts/run-fixall-loop.mjs</string>
    </array>

    <!--
      :20 and :50, deliberately NOT StartInterval 1800. Fixed clock minutes
      interleave with the other two loops working Astrid boards on this Mac:
      cc.astrid.fixall (iOS, claude) at :00/:30, and the Copilot "Work Astrid
      Web queue" workflow at :07/:37 against THIS board. Two harnesses claiming
      the same queue at the same instant is a claim conflict at best.
    -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Minute</key>
            <integer>20</integer>
        </dict>
        <dict>
            <key>Minute</key>
            <integer>50</integer>
        </dict>
    </array>

    <!-- Never at load: installing it must not kick off a run you did not ask for. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/astrid-fixall-web.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/astrid-fixall-web.log</string>
</dict>
</plist>
