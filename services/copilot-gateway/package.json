{
  "name": "@astrid/copilot-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "HTTPS gateway that runs @microsoft/copilot-sdk next to its runtime for Astrid's server Copilot provider (ADEV-244).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@microsoft/copilot-sdk": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6",
    "vitest": "^5.1.1"
  }
}
